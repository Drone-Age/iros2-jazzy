#!/usr/bin/env bash
set -Eeuo pipefail

bashrc="${HOME:?HOME is not set}/.bashrc"
marker_begin="# >>> iros2-0 >>>"
marker_end="# <<< iros2-0 <<<"

touch "${bashrc}"
if grep -Fqx "${marker_begin}" "${bashrc}"; then
  echo "IROS2_0 is already enabled in ${bashrc}"
  exit 0
fi

{
  printf '\n%s\n' "${marker_begin}"
  printf '%s\n' '[ -f /opt/iros2_0/jazzy/setup.bash ] && source /opt/iros2_0/jazzy/setup.bash'
  printf '%s\n' "${marker_end}"
} >> "${bashrc}"

echo "Enabled IROS2_0 in ${bashrc}; start a new Bash shell or source it."
